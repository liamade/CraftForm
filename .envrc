# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                               CraftForm                                    ║
# ╠══════════════════════════════════════════════════════════════════════════════╣
# ║  NIX  ::  .envrc                                                           ║
# ║  Loads the flake.nix dev shell when you cd in.                             ║
# ║  run `direnv allow` once, and again whenever this file changes             ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# use flake comes from nix-direnv, it caches the shell so cd is instant
use flake

# sync .venv on cd and put it on PATH. not --locked like ci so editing a pyproject updates the lock
uv sync --quiet
watch_file uv.lock pyproject.toml lambda/*/pyproject.toml codebuild/*/pyproject.toml
export VIRTUAL_ENV="$PWD/.venv"
PATH_add .venv/bin

# put your AWS_PROFILE and AWS_REGION in .envrc.local (it's gitignored). fine if it's missing
dotenv_if_exists .envrc.local
