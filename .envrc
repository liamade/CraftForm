# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                               CraftForm                                      ║
# ╠══════════════════════════════════════════════════════════════════════════════╣
# ║  NIX  ::  .envrc                                                             ║
# ║  Loads the flake.nix dev shell on cd, drops it on cd out.                    ║
# ║  Run `direnv allow` ONCE -- direnv refuses to run a file it hasn't been      ║
# ║  told to trust, and it re-asks whenever this file changes.                   ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# use_flake comes from nix-direnv, not stock direnv -- it's what caches the shell
# so entry is instant instead of re-evaluating the flake on every single cd
use flake

# python tools come from uv.lock now. sync .venv on cd and put it on PATH.
# plain sync (not --locked like ci) so editing a pyproject updates the lock for you
uv sync --quiet
watch_file uv.lock pyproject.toml lambda/*/pyproject.toml codebuild/*/pyproject.toml
export VIRTUAL_ENV="$PWD/.venv"
PATH_add .venv/bin

# keep the AWS_PROFILE / AWS_REGION you'd rather not commit in .envrc.local,
# which is gitignored. missing file is fine -- that's what the _if_exists is for
dotenv_if_exists .envrc.local
