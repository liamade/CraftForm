# ==============================================================================
# Python
# ==============================================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd

*.env
# uv's venv -- `uv sync` rebuilds it from uv.lock
.venv/

.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ==============================================================================
# Ruff
# ==============================================================================
.ruff_cache/

# ==============================================================================
# Terraform
# ==============================================================================
.terraform/

# State files contain sensitive infrastructure details — never commit
*.tfstate
*.tfstate.backup

# tfvars can contain secrets
*.tfvars
*.tfvars.json

# Local override files are for personal dev tweaks
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Saved plan output can embed sensitive values 
*.tfplan
tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform CLI config
.terraformrc
terraform.rc

# tflint's downloaded plugins, pulled by `tflint --init`
.tflint.d/

# ==============================================================================
# Lambda build artifacts
# ==============================================================================
*.zip
# the release workflow installs deps into here before zipping. (comment on its own
# line on purpose -- git only treats # as a comment at the START of a line)
lambda-build/

# ==============================================================================
# Secrets & credentials
# ==============================================================================
.env
.env.*
*.pem
*.key
secrets.yaml
secrets.json

# ==============================================================================
# Nix / direnv
# ==============================================================================
# the cached dev shell direnv builds -- big, machine-specific, regenerated on demand
.direnv/
# nix build output symlinks
result
result-*
# pycharm's tool symlink from `nix build .#dev-tools` -- also a gc root so nix won't delete it :)
.dev-env
# personal env overrides (AWS_PROFILE etc) that .envrc sources if present
.envrc.local

# ==============================================================================
# Editors / IDEs
# ==============================================================================
# ignore personal vscode junk but keep the shared settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
# same deal for pycharm -- share the module, the interpreter NAME and the
# inspection profile; keep the personal half out (window layout, local history,
# caches, the aws toolkit's active region). misc.xml and the .iml reference the
# sdk by name, so each machine makes its own "CraftForm (Python 3.12)"
# pointing at its own .venv/bin/python
#
# runConfigurations/ is shared because the `ci` one is portable -- it's
# $PROJECT_DIR$ plus `nix develop -c ci`, and nix is on PATH everywhere the
# flake is. ruff.xml and terraform.xml are NOT shared: they hold absolute
# /nix/store paths for this machine's ruff and terraform, which nobody else's
# lock resolves to
.idea/*
!.idea/CraftForm.iml
!.idea/misc.xml
!.idea/modules.xml
!.idea/vcs.xml
!.idea/inspectionProfiles/
!.idea/runConfigurations/
*.swp
*~
CLAUDE.md
.claude/
reports/
research_notes/

# ==============================================================================
# OS
# ==============================================================================
.DS_Store
Thumbs.db
desktop.ini
