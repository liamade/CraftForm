# ==============================================================================
# Python
# ==============================================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd

*.env
# uv's venv - `uv sync` rebuilds it from uv.lock
.venv/

.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ==============================================================================
# Ruff
# ==============================================================================
.ruff_cache/

# ==============================================================================
# Terraform
# ==============================================================================
.terraform/

# state files have sensitive infra details so never commit these
*.tfstate
*.tfstate.backup

# tfvars can contain secrets
*.tfvars
*.tfvars.json

# Local override files are for personal dev tweaks
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Saved plan output can embed sensitive values 
*.tfplan
tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform CLI config
.terraformrc
terraform.rc

# tflint's downloaded plugins, pulled by `tflint --init`
.tflint.d/

# ==============================================================================
# Lambda build artifacts
# ==============================================================================
*.zip
# the release workflow installs deps in here before zipping (this comment has to sit on
# its own line, git only reads # at the start of one)
lambda-build/

# ==============================================================================
# Secrets & credentials
# ==============================================================================
.env
.env.*
*.pem
*.key
secrets.yaml
secrets.json

# ==============================================================================
# Nix / direnv
# ==============================================================================
# the cached dev shell direnv builds - big and machine specific
.direnv/
# nix build output symlinks
result
result-*
# pycharm's tool symlink from `nix build .#dev-tools` - also a gc root so nix won't delete it :)
.dev-env
# personal env overrides (AWS_PROFILE etc) that .envrc sources if present
.envrc.local

# ==============================================================================
# Editors / IDEs
# ==============================================================================
# ignore personal vscode junk but keep the shared settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
# same deal for pycharm - share the project setup and keep the personal stuff out (layout,
# history, caches). ruff.xml and terraform.xml stay out since they point at this machine's /nix/store
.idea/*
!.idea/CraftForm.iml
!.idea/misc.xml
!.idea/modules.xml
!.idea/vcs.xml
!.idea/inspectionProfiles/
!.idea/runConfigurations/
*.swp
*~
CLAUDE.md
.claude/
reports/
research_notes/

# ==============================================================================
# OS
# ==============================================================================
.DS_Store
Thumbs.db
desktop.ini
